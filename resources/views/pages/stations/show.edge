@include('partials/header')
{{-- views/pages/stations/show.edge --}}
<div class="container mx-auto px-4 py-8">
  <div class="max-w-4xl mx-auto">
    {{-- En-tête station --}}
    <div class="bg-white rounded-lg shadow-lg overflow-hidden">
      <div class="p-6">
        <h1 class="text-2xl font-bold text-gray-900 mb-2">Station {{ station.details.address }}</h1>
        <p class="text-gray-600">{{ station.details.postal_code }} {{ station.details.city }}</p>

        @if(station.details.is_24h)
          <div class="mt-4 inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
            <svg class="h-4 w-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Ouvert 24h/24
          </div>
        @endif
      </div>

      {{-- Prix des carburants --}}
      <div class="border-t border-gray-200">
        <div class="px-6 py-4">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Prix des carburants</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            @each(fuel in station.fuels)
            <div class="bg-gray-50 rounded-lg p-4">
              <div class="text-sm text-gray-500">{{ fuel.type }}</div>
              <div class="mt-1 text-2xl font-bold text-blue-600">{{ fuel.price }}€/L</div>
              <div class="mt-2 text-xs text-gray-500">
                Mis à jour le {{ new Date(fuel.last_update).toLocaleString() }}
              </div>
            </div>
            @end
          </div>
        </div>
      </div>

      {{-- Carte si coordinates disponibles --}}
      @if(station.details.coordinates)
        <div class="border-t border-gray-200">
          <div class="px-6 py-4">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Localisation</h2>
            <div id="map" class="h-96 rounded-lg shadow-inner"></div>
          </div>
        </div>
      @endif
    </div>

    {{-- Bouton retour --}}
    <div class="mt-6">
      <a href="javascript:history.back()" class="inline-flex items-center text-blue-600 hover:text-blue-800">
        <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Retour à la liste
      </a>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Sécuriser les données avec safe pour éviter les injections XSS
    const stationData = {
      latitude: {{ station.details.coordinates[1] }},
      longitude: {{ station.details.coordinates[0] }},
      address: `{{ station.details.address }}`,
      city: `{{ station.details.city }}`,
      postal_code: `{{ station.details.postal_code }}`
    }

    // Initialiser la carte
    const map = L.map('map').setView([stationData.latitude, stationData.longitude], 15)

    // Ajouter le layer OpenStreetMap
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '© OpenStreetMap contributors'
    }).addTo(map)

    // Ajouter le marqueur de la station
    const marker = L.marker([stationData.latitude, stationData.longitude]).addTo(map)
      .bindPopup(`
      <strong>${stationData.address}</strong><br>
      ${stationData.postal_code} ${stationData.city}
    `)
      .openPopup()

    // Ajouter un cercle pour montrer la zone
    L.circle([stationData.latitude, stationData.longitude], {
      color: 'blue',
      fillColor: '#30a4f2',
      fillOpacity: 0.1,
      radius: 500
    }).addTo(map)
  })
</script>
